{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sliccy-ai",
  "main": "src/router.js",
  "account_id": "155ec15a52a18a14801e04b019da5e5a",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "*.sliccy.ai/*", "zone_name": "sliccy.ai" },
    { "pattern": "www.sliccy.ai/7*", "zone_name": "sliccy.ai" },
    { "pattern": "www.sliccy.ai/os/*", "zone_name": "sliccy.ai" },
    { "pattern": "www.sliccy.ai/oauth/client.json", "zone_name": "sliccy.ai" },
    { "pattern": "www.sliccy.ai/download/sliccy.dmg*", "zone_name": "sliccy.ai" },
    { "pattern": "*.sliccy.now/*", "zone_name": "sliccy.now" }
  ],
  "r2_buckets": [
    { "binding": "BIOS", "bucket_name": "slicc-bios" },
    { "binding": "SERVE_STORAGE", "bucket_name": "sliccy-now-basic-storage" }
  ],
  "vars": { "SUPPORT_IMS_SEVEN": "prod", "SUPPORT_IMS_BRANCHES": "stg1" },
  "version_metadata": { "binding": "VERSION" },
  "services": [
    { "binding": "V6", "service": "slicc-tray-hub" },
    { "binding": "V6_PREVIEW", "service": "slicc-preview" }
  ],
  "rules": [{ "type": "Text", "globs": ["**/cherry/dist/preview-bridge.js"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "HOMES", "class_name": "NtfyHome" },
      {
        "name": "TRAY_HUB",
        "class_name": "SessionTrayDurableObject",
        "script_name": "slicc-tray-hub"
      },
      { "name": "SERVE", "class_name": "ServeHost" }
    ]
  },
  "ratelimits": [
    { "name": "CLAIMS", "namespace_id": "4201", "simple": { "limit": 10, "period": 60 } },
    { "name": "DELIVERIES", "namespace_id": "4202", "simple": { "limit": 300, "period": 60 } }
  ],
  "migrations": [
    { "tag": "v1-ntfy-homes", "new_sqlite_classes": ["NtfyHome"] },
    { "tag": "v2-serve-hosts", "new_sqlite_classes": ["ServeHost"] }
  ]
}
