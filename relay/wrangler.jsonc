{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sliccy-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "vars": {
    "MAILBOX_GATE": "off",
    "ALLOWED_ORIGINS": "https://lease-pilot.sliccy.ai,https://seven.sliccy.ai"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOX", "class_name": "Mailbox" },
      { "name": "GATE", "class_name": "Gate" }
    ]
  },
  "ratelimits": [
    { "name": "OPENS", "namespace_id": "4301", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITES", "namespace_id": "4302", "simple": { "limit": 60, "period": 60 } },
    { "name": "TAKES", "namespace_id": "4303", "simple": { "limit": 150, "period": 60 } },
    { "name": "POLLS", "namespace_id": "4304", "simple": { "limit": 150, "period": 60 } }
  ],
  "migrations": [{ "tag": "v1-relay-mailbox", "new_sqlite_classes": ["Mailbox", "Gate"] }]
}
