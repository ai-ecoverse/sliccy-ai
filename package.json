{
  "name": "sliccy-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker that serves *.sliccy.ai: seven.sliccy.ai and branch previews of the new SLICC",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/sliccy-ai.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "test": "node --test 'test/integration/*.test.mjs'",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "deploy": "wrangler deploy",
    "test:live": "node --test 'test/integration/live/*.test.mjs'"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "1.4.1",
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.16",
    "miniflare": "4.20260730.0",
    "monocart-coverage-reports": "2.13.0",
    "playwright-core": "1.63.0",
    "wrangler": "4.147.0"
  }
}
